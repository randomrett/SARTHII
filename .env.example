# =====================================================================
# SAARTHI ENVIRONMENT CONFIGURATION TEMPLATE (.env.example)
# =====================================================================

# ---------------------------------------------------------------------
# FRONTEND CONFIGURATION (Vercel / Vite)
# ---------------------------------------------------------------------
# Target URL for FastAPI Backend REST API
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Target URL for Live Push WebSockets (wss:// in production)
VITE_WS_URL=ws://localhost:8000/ws/updates

# Show Quick Demo Login Role Switcher on Login Page (set false in production)
VITE_ENABLE_DEMO_LOGINS=true

# ---------------------------------------------------------------------
# BACKEND CONFIGURATION (FastAPI Container Host / Docker)
# ---------------------------------------------------------------------
# Database connection string (PostgreSQL for prod, SQLite for dev)
DATABASE_URL=postgresql://postgres:password@localhost:5432/saarthi_db

# JWT Signing Secret (Generate a strong random string for production)
SECRET_KEY=saarthi-sih2026-super-secret-key-change-in-production

# Google Gemini API Key (ONLY set on backend host — NEVER expose on frontend!)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# CORS Allowed Origins (Comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://saarthi-frontend.vercel.app

# Server Port (Binding environment variable for container hosts like Cloud Run / Render)
PORT=8000
